---
import GazetteHighlights from "./GazetteHighlights.astro";
import GazetteNote from "./GazetteNote.astro";
import GazettePermalink from "./GazettePermalink.astro";
import { parseAuthors } from "../lib/feed";
import { wantsMarginNote, type GazetteItem } from "../lib/gazette";

interface Props {
	item: GazetteItem;
	highlightsHtml: string[];
	permalink?: string | undefined;
	marginNote?: boolean;
}

const { item, highlightsHtml, permalink, marginNote = true } = Astro.props;

const hasNote = marginNote && wantsMarginNote(highlightsHtml.length);
const byline = parseAuthors(item.author).join(", ");
---

<li
	class:list={{ "gazette-noted": hasNote }}
	data-note-anchor={hasNote ? "" : undefined}
>
	<GazetteHighlights
		class="gazette-edition-title"
		highlightsHtml={highlightsHtml}
	>
		<a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a
		><GazettePermalink href={permalink} title={item.title} />
		{
			byline && (
				<>
					<br />
					{/* prettier-ignore */}
					<span class="gazette-byline">By <span>{byline}</span></span>
				</>
			)
		}
	</GazetteHighlights>
	{
		hasNote && (
			<GazetteNote title={item.title} highlightsHtml={highlightsHtml} />
		)
	}
</li>
