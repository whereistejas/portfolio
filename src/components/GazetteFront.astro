---
import GazetteHighlights from "./GazetteHighlights.astro";
import GazetteNote from "./GazetteNote.astro";
import GazetteStory from "./GazetteStory.astro";
import { parseAuthors } from "../lib/feed";
import { aboveTheFold, GLANCE_HEADING } from "../lib/gazette-fold";
import {
	byRecency,
	formatLongDate,
	wantsMarginNote,
	type Issue,
} from "../lib/gazette";

interface Props {
	name: string;
	tagline: string | undefined;
	issue: Issue;
	highlightsHtml: Map<string, string[]>;
	updatedAt: Date;
	numbered: boolean;
}

const { name, tagline, issue, highlightsHtml, updatedAt, numbered } =
	Astro.props;

const SIDE_STORIES = 3;
const GLANCE_ITEMS = 6;

const side = issue.rest
	.filter((item) => item.highlights.length > 0)
	.slice(0, SIDE_STORIES);
const remaining = issue.rest
	.filter((item) => !side.includes(item))
	.sort(byRecency);
const glance = remaining.slice(0, GLANCE_ITEMS);
const more = remaining.slice(GLANCE_ITEMS);
const fold = more.slice(0, aboveTheFold(glance, issue.lead, side, more));
const below = more.slice(fold.length);
const highlightsOf = (id: string) => highlightsHtml.get(id) ?? [];
---

<section class="gazette-front">
	<div class="gazette-masthead">
		<span>{formatLongDate(updatedAt)}</span>
		<h1>{name}</h1>
		<span>{numbered && `No. ${issue.number}, WIP`}</span>
		{tagline && <p class="gazette-tagline">{tagline}</p>}
	</div>

	<div
		class:list={[
			"gazette-top",
			{
				"gazette-top--glance": glance.length > 0,
				"gazette-top--side": side.length > 0,
			},
		]}
	>
		{
			glance.length > 0 && (
				<aside class="gazette-glance">
					<h2>{GLANCE_HEADING}</h2>
					<ul>
						{glance.map((item) => {
							const highlights = highlightsOf(item.readwise_id);
							const hasNote = wantsMarginNote(highlights.length);
							return (
								<li
									class:list={{ "gazette-noted": hasNote }}
									data-note-anchor={hasNote ? "" : undefined}
								>
									<p>
										<a
											href={item.url}
											target="_blank"
											rel="noopener noreferrer"
										>
											{item.title}
										</a>{" "}
										{item.summary}
									</p>
									<GazetteHighlights
										class="gazette-meta"
										highlightsHtml={highlights}
									>
										{parseAuthors(item.author).length > 0 && (
											<span>{parseAuthors(item.author).join(", ")}</span>
										)}
									</GazetteHighlights>
									{hasNote && (
										<GazetteNote
											title={item.title}
											highlightsHtml={highlights}
										/>
									)}
								</li>
							);
						})}
					</ul>
				</aside>
			)
		}

		<div class="gazette-center">
			<GazetteStory
				item={issue.lead}
				highlightsHtml={highlightsOf(issue.lead.readwise_id)}
				variant="lead"
				noted
			/>
			{
				fold.length > 0 && (
					<div class="gazette-fold">
						{fold.map((item) => (
							<GazetteStory
								item={item}
								highlightsHtml={highlightsOf(item.readwise_id)}
								variant="side"
							/>
						))}
					</div>
				)
			}
		</div>

		{
			side.length > 0 && (
				<div class="gazette-side">
					{side.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}
	</div>

	{
		below.length > 0 && (
			<div class="gazette-more-grid">
				{below.map((item) => (
					<GazetteStory
						item={item}
						highlightsHtml={highlightsOf(item.readwise_id)}
						variant="side"
					/>
				))}
			</div>
		)
	}
</section>
