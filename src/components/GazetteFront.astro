---
import GazetteStory from "./GazetteStory.astro";
import { aboveTheFold } from "../lib/gazette-fold";
import { byRecency, formatLongDate, type Issue } from "../lib/gazette";

interface Props {
	name: string;
	tagline: string | undefined;
	issue: Issue;
	highlightsHtml: Map<string, string[]>;
	updatedAt: Date;
	numbered: boolean;
}

const { name, tagline, issue, highlightsHtml, updatedAt, numbered } =
	Astro.props;

const SIDE_STORIES = 3;

const right = issue.rest
	.filter((item) => item.highlights.length > 0)
	.slice(0, SIDE_STORIES);
const remaining = issue.rest
	.filter((item) => !right.includes(item))
	.sort(byRecency);
const left = remaining.slice(0, SIDE_STORIES);
const more = remaining.slice(SIDE_STORIES);
const fold = more.slice(0, aboveTheFold(left, issue.lead, right, more));
const below = more.slice(fold.length);
const highlightsOf = (id: string) => highlightsHtml.get(id) ?? [];
---

<section class="gazette-front">
	<div class="gazette-masthead">
		<span>{formatLongDate(updatedAt)}</span>
		<h1>{name}</h1>
		<span>{numbered && `No. ${issue.number}, WIP`}</span>
		{tagline && <p class="gazette-tagline">{tagline}</p>}
	</div>

	<div
		class:list={[
			"gazette-top",
			{
				"gazette-top--left": left.length > 0,
				"gazette-top--right": right.length > 0,
			},
		]}
	>
		{
			left.length > 0 && (
				<div class="gazette-side gazette-side--left">
					{left.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}

		<div class="gazette-center">
			<GazetteStory
				item={issue.lead}
				highlightsHtml={highlightsOf(issue.lead.readwise_id)}
				variant="lead"
				noted
			/>
			{
				fold.length > 0 && (
					<div class="gazette-fold">
						{fold.map((item) => (
							<GazetteStory
								item={item}
								highlightsHtml={highlightsOf(item.readwise_id)}
								variant="side"
							/>
						))}
					</div>
				)
			}
		</div>

		{
			right.length > 0 && (
				<div class="gazette-side gazette-side--right">
					{right.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}
	</div>

	{
		below.length > 0 && (
			<div class="gazette-more-grid">
				{below.map((item) => (
					<GazetteStory
						item={item}
						highlightsHtml={highlightsOf(item.readwise_id)}
						variant="side"
					/>
				))}
			</div>
		)
	}
</section>
