---
import GazetteEditionItem from "./GazetteEditionItem.astro";
import GazetteStory from "./GazetteStory.astro";
import {
	formatLongDate,
	formatVolume,
	type GazetteItem,
	type Sibling,
} from "../lib/gazette";
import type { Front } from "../lib/gazette-fold";

interface Props {
	name: string;
	tagline: string | undefined;
	sibling: Sibling | undefined;
	edition: number;
	front: Front;
	highlightsHtml: Map<string, string[]>;
	updatedAt: Date;
	numbered: boolean;
	permalinkOf: ((item: GazetteItem) => string) | undefined;
}

const {
	name,
	tagline,
	sibling,
	edition,
	front,
	highlightsHtml,
	updatedAt,
	numbered,
	permalinkOf,
} = Astro.props;
const { lead, left, right, fold, below, compact } = front;
const highlightsOf = (id: string) => highlightsHtml.get(id) ?? [];
---

<section class="gazette-front">
	<div class="gazette-masthead">
		<h1>{name}</h1>
		{
			sibling && (
				<a class="gazette-ear" href={sibling.href}>
					{sibling.label} →
				</a>
			)
		}
		<span class="gazette-volume">
			{numbered ? formatVolume(edition) : "Vol. in fieri"}
		</span>
		<span class="gazette-date">{formatLongDate(updatedAt)}</span>
		{tagline && <p class="gazette-tagline">{tagline}</p>}
	</div>

	<div
		class:list={[
			"gazette-top",
			{
				"gazette-top--left": left.length > 0,
				"gazette-top--right": right.length > 0,
			},
		]}
	>
		{
			left.length > 0 && (
				<div class="gazette-side gazette-side--left">
					{left.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							permalink={permalinkOf?.(item)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}

		<div class="gazette-center">
			<GazetteStory
				item={lead}
				highlightsHtml={highlightsOf(lead.readwise_id)}
				permalink={permalinkOf?.(lead)}
				variant="lead"
				noted
			/>
			{
				fold.length > 0 && (
					<div class="gazette-fold">
						{fold.map((item) => (
							<GazetteStory
								item={item}
								highlightsHtml={highlightsOf(item.readwise_id)}
								permalink={permalinkOf?.(item)}
								variant="side"
							/>
						))}
					</div>
				)
			}
		</div>

		{
			right.length > 0 && (
				<div class="gazette-side gazette-side--right">
					{right.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							permalink={permalinkOf?.(item)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}
	</div>

	{
		compact.length > 0 && (
			<ul class="gazette-edition-list gazette-compact">
				{compact.map((item) => (
					<GazetteEditionItem
						item={item}
						highlightsHtml={highlightsOf(item.readwise_id)}
						permalink={permalinkOf?.(item)}
						marginNote={false}
					/>
				))}
			</ul>
		)
	}

	{
		below.length > 0 && (
			<div class="gazette-more-grid">
				{below.map((item) => (
					<GazetteStory
						item={item}
						highlightsHtml={highlightsOf(item.readwise_id)}
						permalink={permalinkOf?.(item)}
						variant="side"
					/>
				))}
			</div>
		)
	}
</section>
