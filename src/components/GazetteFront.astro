---
import GazetteStory from "./GazetteStory.astro";
import { formatLongDate } from "../lib/gazette";
import type { Front } from "../lib/gazette-fold";

interface Props {
	name: string;
	tagline: string | undefined;
	edition: number;
	front: Front;
	highlightsHtml: Map<string, string[]>;
	updatedAt: Date;
	numbered: boolean;
}

const { name, tagline, edition, front, highlightsHtml, updatedAt, numbered } =
	Astro.props;
const { lead, left, right, fold, below } = front;
const highlightsOf = (id: string) => highlightsHtml.get(id) ?? [];
---

<section class="gazette-front">
	<div class="gazette-masthead">
		<span>{formatLongDate(updatedAt)}</span>
		<h1>{name}</h1>
		<span>{numbered ? `No. ${edition}` : "WIP"}</span>
		{tagline && <p class="gazette-tagline">{tagline}</p>}
	</div>

	<div
		class:list={[
			"gazette-top",
			{
				"gazette-top--left": left.length > 0,
				"gazette-top--right": right.length > 0,
			},
		]}
	>
		{
			left.length > 0 && (
				<div class="gazette-side gazette-side--left">
					{left.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}

		<div class="gazette-center">
			<GazetteStory
				item={lead}
				highlightsHtml={highlightsOf(lead.readwise_id)}
				variant="lead"
				noted
			/>
			{
				fold.length > 0 && (
					<div class="gazette-fold">
						{fold.map((item) => (
							<GazetteStory
								item={item}
								highlightsHtml={highlightsOf(item.readwise_id)}
								variant="side"
							/>
						))}
					</div>
				)
			}
		</div>

		{
			right.length > 0 && (
				<div class="gazette-side gazette-side--right">
					{right.map((item) => (
						<GazetteStory
							item={item}
							highlightsHtml={highlightsOf(item.readwise_id)}
							variant="side"
							noted
						/>
					))}
				</div>
			)
		}
	</div>

	{
		below.length > 0 && (
			<div class="gazette-more-grid">
				{below.map((item) => (
					<GazetteStory
						item={item}
						highlightsHtml={highlightsOf(item.readwise_id)}
						variant="side"
					/>
				))}
			</div>
		)
	}
</section>
