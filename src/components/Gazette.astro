---
import GazetteEdition from "./GazetteEdition.astro";
import GazetteFront from "./GazetteFront.astro";
import GazettePaper from "./GazettePaper.astro";
import { renderHighlightsHtml } from "../lib/feed";
import {
	byRecency,
	groupIntoIssues,
	withoutItems,
	type GazetteItem,
	type Sibling,
} from "../lib/gazette";
import { layoutFront } from "../lib/gazette-fold";

interface Props {
	name: string;
	tagline?: string;
	items: GazetteItem[];
	sibling?: Sibling;
	numbered?: boolean;
}

const { name, tagline, items, sibling, numbered = true } = Astro.props;

const [current, ...older] = groupIntoIssues(items);
const backfill = numbered
	? []
	: older.flatMap((issue) => [issue.lead, ...issue.rest]).sort(byRecency);
const front = current && layoutFront(current, backfill);
const taken = new Set(front?.fold);
const previous = older.flatMap((issue) => withoutItems(issue, taken) ?? []);
const highlightHtmlById = await renderHighlightsHtml(items);
const builtAt = new Date();
---

<GazettePaper>
	{
		current && front && (
			<GazetteFront
				name={name}
				tagline={tagline}
				sibling={sibling}
				edition={current.number}
				front={front}
				highlightsHtml={highlightHtmlById}
				updatedAt={builtAt}
				numbered={numbered}
			/>
		)
	}
	{
		previous.length > 0 && (
			<section class="gazette-previous">
				<div class="gazette-grid">
					{previous.map((issue) => (
						<GazetteEdition
							issue={issue}
							highlightsHtml={highlightHtmlById}
							numbered={numbered}
						/>
					))}
				</div>
			</section>
		)
	}
</GazettePaper>
