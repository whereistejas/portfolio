---
import GazetteHighlights from "./GazetteHighlights.astro";
import GazetteNote from "./GazetteNote.astro";
import GazettePermalink from "./GazettePermalink.astro";
import { parseAuthors } from "../lib/feed";
import {
	pullQuoteIndex,
	wantsMarginNote,
	type GazetteItem,
} from "../lib/gazette";

interface Props {
	item: GazetteItem;
	highlightsHtml: string[];
	variant: "lead" | "side";
	noted?: boolean;
	permalink?: string | undefined;
}

const { item, highlightsHtml, variant, noted = false, permalink } = Astro.props;

const byline = parseAuthors(item.author).join(", ");
const pullIndex = variant === "lead" ? pullQuoteIndex(item) : -1;
const pullQuote = highlightsHtml[pullIndex];
const tucked = highlightsHtml.filter((_, i) => i !== pullIndex);
const hasNote =
	tucked.length > 0 && (noted || wantsMarginNote(highlightsHtml.length));
---

<article
	class:list={[
		"gazette-story",
		`gazette-story--${variant}`,
		{ "gazette-noted": hasNote },
	]}
	data-note-anchor={hasNote ? "" : undefined}
>
	<div class="gazette-headline">
		<a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a
		>
		<GazettePermalink href={permalink} title={item.title} />
	</div>
	{
		byline && (
			<p class="gazette-byline">
				By <span>{byline}</span>
			</p>
		)
	}
	{
		variant === "lead" ? (
			<p class="gazette-dek">{item.summary}</p>
		) : (
			item.summary && <p class="gazette-dek gazette-dek-fill">{item.summary}</p>
		)
	}
	{pullQuote && <blockquote class="gazette-pull" set:html={pullQuote} />}
	<GazetteHighlights
		class="gazette-meta"
		highlightsHtml={tucked}
		more={pullQuote !== undefined}
	/>
	{hasNote && <GazetteNote title={item.title} highlightsHtml={tucked} />}
</article>
