---
import GazetteEditionItem from "./GazetteEditionItem.astro";
import GazetteHighlights from "./GazetteHighlights.astro";
import GazetteNote from "./GazetteNote.astro";
import GazettePermalink from "./GazettePermalink.astro";
import { parseAuthors } from "../lib/feed";
import {
	anchorsOf,
	formatDate,
	formatVolume,
	itemPathsOf,
	splitIntoColumns,
	volumePath,
	type Issue,
	type GazetteItem,
} from "../lib/gazette";

interface Props {
	issue: Issue;
	highlightsHtml: Map<string, string[]>;
	numbered: boolean;
	anchored?: boolean;
}

const { issue, highlightsHtml, numbered, anchored = false } = Astro.props;

const LEAD_LINES = 4;
const LINES_PER_COLUMN = 9;
const MAX_SPAN = 3;
const TWO_LINE_TITLE = 45;

const span = Math.min(
	MAX_SPAN,
	Math.ceil((LEAD_LINES + issue.rest.length) / LINES_PER_COLUMN)
);
const highlightsOf = (item: GazetteItem) =>
	highlightsHtml.get(item.readwise_id) ?? [];
const anchors = numbered ? anchorsOf(issue) : undefined;
const anchorOf = (item: GazetteItem) =>
	anchored ? anchors?.get(item.readwise_id) : undefined;
const paths = numbered ? itemPathsOf(issue) : undefined;
const permalinkOf = (item: GazetteItem) => paths?.get(item.readwise_id);
const byline = parseAuthors(issue.lead.author).join(", ");
const leadHighlights = highlightsOf(issue.lead);
const hasNote = leadHighlights.length > 0;
const [firstColumn = [], ...otherColumns] = splitIntoColumns(
	issue.rest,
	span,
	LEAD_LINES,
	(item) => (item.title.length > TWO_LINE_TITLE ? 2 : 1)
);
---

<article
	class:list={["gazette-edition", span > 1 && `gazette-edition--span-${span}`]}
	id={`issue-${issue.number}`}
>
	<div class="gazette-edition-head">
		{
			numbered ? (
				<>
					<a class="gazette-edition-no" href={volumePath(issue.number)}>
						{formatVolume(issue.number)}
					</a>
					<span>{formatDate(issue.weekEnd)}</span>
				</>
			) : (
				<span class="gazette-edition-no">{formatDate(issue.weekEnd)}</span>
			)
		}
	</div>

	<div class="gazette-edition-body">
		<div class="gazette-edition-column">
			<div
				class:list={["gazette-edition-lead", { "gazette-noted": hasNote }]}
				data-note-anchor={hasNote ? "" : undefined}
				id={anchorOf(issue.lead)}
			>
				<div class="gazette-headline">
					<a href={issue.lead.url} target="_blank" rel="noopener noreferrer"
						>{issue.lead.title}</a
					>
					<GazettePermalink
						href={permalinkOf(issue.lead)}
						title={issue.lead.title}
					/>
				</div>
				{
					byline && (
						<p class="gazette-byline">
							By <span>{byline}</span>
						</p>
					)
				}
				<p class="gazette-dek">{issue.lead.summary}</p>
				<GazetteHighlights
					class="gazette-meta"
					highlightsHtml={leadHighlights}
				/>
				{
					hasNote && (
						<GazetteNote
							title={issue.lead.title}
							highlightsHtml={leadHighlights}
						/>
					)
				}
			</div>

			{
				firstColumn.length > 0 && (
					<ul class="gazette-edition-list">
						{firstColumn.map((item) => (
							<GazetteEditionItem
								item={item}
								highlightsHtml={highlightsOf(item)}
								id={anchorOf(item)}
								permalink={permalinkOf(item)}
							/>
						))}
					</ul>
				)
			}
		</div>
		{
			otherColumns.map((column) => (
				<div class="gazette-edition-column">
					<ul class="gazette-edition-list">
						{column.map((item) => (
							<GazetteEditionItem
								item={item}
								highlightsHtml={highlightsOf(item)}
								id={anchorOf(item)}
								permalink={permalinkOf(item)}
							/>
						))}
					</ul>
				</div>
			))
		}
	</div>
</article>
