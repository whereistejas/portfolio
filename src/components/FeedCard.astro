---
interface Props {
	title: string;
	href: string;
	summary?: string;
	category?: string;
	metaParts?: string[];
	linkWholeCard?: boolean;
}

const {
	title,
	href,
	summary = "",
	category = "",
	metaParts = [],
	linkWholeCard = false,
} = Astro.props;

const Wrapper = linkWholeCard ? "a" : "div";
const wrapperProps = linkWholeCard ? { href } : {};
const Title = linkWholeCard ? "span" : "a";
const titleProps = linkWholeCard
	? {}
	: { href, target: "_blank", rel: "noopener noreferrer" };
---

<Wrapper class="feed-item" {...wrapperProps}>
	<Title class="feed-title" {...titleProps}>{title}</Title>
	{summary && <span class="feed-desc">{summary}</span>}
	<span class="feed-meta">
		{
			category && (
				<>
					<span class="hidden items-center md:inline-flex">{category}</span>
					<span class="hidden items-center md:inline-flex">
						<span class="feed-separator">{"\u2726"}</span>
					</span>
				</>
			)
		}
		{
			metaParts.map((part, i) => (
				<>
					{i > 0 && <span class="feed-separator">{"\u2726"}</span>}
					<span>{part}</span>
				</>
			))
		}
	</span>
</Wrapper>
