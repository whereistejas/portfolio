---
import { getCollection } from "astro:content";

import Gazette from "../components/Gazette.astro";
import Page from "../layouts/page.astro";

const queueEntries = (await getCollection("readwise-queue")).map(
	(entry) => entry.data
);
---

<Page title="Inbox">
	<Fragment slot="main">
		<Gazette
			name="Inbox"
			tagline="What I’ve saved to read, one week at a time."
			items={queueEntries}
			numbered={false}
		/>
	</Fragment>
</Page>
