---
import { getCollection } from "astro:content";

import Paper from "../components/Gazette.astro";
import Page from "../layouts/page.astro";
import { GAZETTE_FONTS, GAZETTE_PREFETCH_FONTS } from "../lib/gazette";

const archiveEntries = (await getCollection("readwise-archive")).map(
	(entry) => entry.data
);
---

<Page
	title="Gazette"
	fonts={GAZETTE_FONTS}
	prefetchFonts={GAZETTE_PREFETCH_FONTS}
>
	<Fragment slot="main">
		<Paper
			name="Gazette"
			tagline="My reading, filed weekly."
			sibling={{ href: "/tbr", label: "Early Edition" }}
			items={archiveEntries}
			recent={12}
		/>
	</Fragment>
</Page>
