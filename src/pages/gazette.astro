---
import { getCollection } from "astro:content";

import Paper from "../components/Gazette.astro";
import Page from "../layouts/page.astro";

const archiveEntries = (await getCollection("readwise-archive")).map(
	(entry) => entry.data
);
---

<Page
	title="Gazette"
	fonts={["economist-serif-roman.woff2", "economist-serif-italic.woff2"]}
	prefetchFonts={[
		"NebulaSans-Book.woff2",
		"NebulaSans-BookItalic.woff2",
		"NebulaSans-Bold.woff2",
		"NebulaSans-BoldItalic.woff2",
	]}
>
	<Fragment slot="main">
		<Paper
			name="Gazette"
			tagline="My reading, filed weekly."
			sibling={{ href: "/tbr", label: "Early Edition" }}
			items={archiveEntries}
		/>
	</Fragment>
</Page>
