---
import { getCollection } from "astro:content";

import GazetteEdition from "../components/GazetteEdition.astro";
import GazetteFront from "../components/GazetteFront.astro";
import Page from "../layouts/page.astro";
import { renderHighlightsHtml } from "../lib/feed";
import { groupIntoIssues } from "../lib/gazette";

const archiveEntries = (await getCollection("readwise-archive")).map(
	(entry) => entry.data
);

const [current, ...previous] = groupIntoIssues(archiveEntries);
const highlightHtmlById = await renderHighlightsHtml(archiveEntries);
const builtAt = new Date();
---

<Page title="Gazette" wide>
	<Fragment slot="main">
		<div class="gazette">
			{
				current && (
					<GazetteFront
						issue={current}
						highlightsHtml={highlightHtmlById}
						updatedAt={builtAt}
					/>
				)
			}
			{
				previous.length > 0 && (
					<section class="gazette-previous">
						<h2>Previous editions</h2>
						<div class="gazette-grid">
							{previous.map((issue) => (
								<GazetteEdition
									issue={issue}
									highlightsHtml={highlightHtmlById}
								/>
							))}
						</div>
					</section>
				)
			}
		</div>
	</Fragment>
</Page>


<script>
	const RAIL = window.matchMedia("(width >= 116rem)");
	const NOTE_GAP = 16;

	function placeNotes(root: HTMLElement) {
		if (!RAIL.matches) {
			delete root.dataset["rail"];
			root.style.minHeight = "";
			return;
		}
		root.dataset["rail"] = "";

		const rootTop = root.getBoundingClientRect().top;
		const notes = Array.from(
			root.querySelectorAll<HTMLElement>("[data-gazette-note]")
		)
			.filter((note) => note.checkVisibility())
			.map((note) => {
				const anchor = note.closest<HTMLElement>("[data-note-anchor]") ?? note;
				return { note, target: anchor.getBoundingClientRect().top - rootTop };
			})
			.sort((a, b) => a.target - b.target);

		let floor = 0;
		for (const { note, target } of notes) {
			const top = Math.max(target, floor);
			note.style.top = `${top}px`;
			floor = top + note.offsetHeight + NOTE_GAP;
		}

		const minHeight = `${floor}px`;
		if (root.style.minHeight !== minHeight) root.style.minHeight = minHeight;
	}

	const root = document.querySelector<HTMLElement>(".gazette");
	if (root) {
		let queued = false;
		const schedule = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				placeNotes(root);
			});
		};

		const observer = new ResizeObserver(schedule);
		observer.observe(root);
		root
			.querySelectorAll("[data-gazette-note], [data-note-anchor]")
			.forEach((element) => observer.observe(element));
		new MutationObserver(() => placeNotes(root)).observe(root, {
			attributeFilter: ["open"],
			subtree: true,
		});
		RAIL.addEventListener("change", schedule);
		document.fonts.ready.then(schedule);
		schedule();
	}
</script>
