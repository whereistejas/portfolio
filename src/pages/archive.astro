---
import { getCollection } from "astro:content";

import GazetteEdition from "../components/GazetteEdition.astro";
import GazetteFront from "../components/GazetteFront.astro";
import Page from "../layouts/page.astro";
import { renderHighlightsHtml } from "../lib/feed";
import { groupIntoIssues } from "../lib/gazette";

const archiveEntries = (await getCollection("readwise-archive")).map(
	(entry) => entry.data
);

const [current, ...previous] = groupIntoIssues(archiveEntries);
const highlightHtmlById = await renderHighlightsHtml(archiveEntries);
const builtAt = new Date();
---

<Page title="Gazette" wide>
	<Fragment slot="main">
		<div class="gazette">
			{
				current && (
					<GazetteFront
						issue={current}
						highlightsHtml={highlightHtmlById}
						updatedAt={builtAt}
					/>
				)
			}
			{
				previous.length > 0 && (
					<section class="gazette-previous">
						<h2>Previous editions</h2>
						<div class="gazette-grid">
							{previous.map((issue) => (
								<GazetteEdition
									issue={issue}
									highlightsHtml={highlightHtmlById}
								/>
							))}
						</div>
					</section>
				)
			}
		</div>
	</Fragment>
</Page>


<script>
	const RAIL = window.matchMedia("(width >= 116rem)");
	const REDUCED_MOTION = window.matchMedia("(prefers-reduced-motion: reduce)");
	const NOTE_GAP = 16;
	const EASE_IN_OUT = "cubic-bezier(0.77, 0, 0.175, 1)";

	function isOpen(note: HTMLElement): boolean {
		const open =
			note.parentElement
				?.querySelector(":scope > .gazette-highlights")
				?.hasAttribute("open") ?? false;
		if (!open) delete note.dataset["openedAt"];
		return open;
	}

	function moveTo(note: HTMLElement, top: number) {
		const previous = Number.parseFloat(note.style.top);
		note.style.top = `${top}px`;
		if (Number.isNaN(previous) || previous === top || REDUCED_MOTION.matches) return;
		note.animate(
			[{ transform: `translateY(${previous - top}px)` }, { transform: "translateY(0)" }],
			{ duration: 200, easing: EASE_IN_OUT }
		);
	}

	function placeNotes(root: HTMLElement) {
		if (!RAIL.matches) {
			delete root.dataset["rail"];
			root.style.minHeight = "";
			return;
		}
		root.dataset["rail"] = "";

		const rootTop = root.getBoundingClientRect().top;
		const notes = Array.from(
			root.querySelectorAll<HTMLElement>("[data-gazette-note]")
		)
			.filter(isOpen)
			.map((note) => {
				note.dataset["openedAt"] ??= String(performance.now());
				const anchor = note.closest<HTMLElement>("[data-note-anchor]") ?? note;
				return {
					note,
					target: anchor.getBoundingClientRect().top - rootTop,
					openedAt: Number(note.dataset["openedAt"]),
				};
			})
			.sort((a, b) => a.openedAt - b.openedAt);

		const taken: { top: number; bottom: number }[] = [];
		let floor = 0;
		for (const { note, target } of notes) {
			const height = note.offsetHeight;
			let top = target;
			for (const slot of [...taken].sort((a, b) => a.top - b.top)) {
				if (top + height + NOTE_GAP > slot.top && top < slot.bottom + NOTE_GAP) {
					top = slot.bottom + NOTE_GAP;
				}
			}
			taken.push({ top, bottom: top + height });
			moveTo(note, top);
			floor = Math.max(floor, top + height + NOTE_GAP);
		}

		const minHeight = `${floor}px`;
		if (root.style.minHeight !== minHeight) root.style.minHeight = minHeight;
	}

	const root = document.querySelector<HTMLElement>(".gazette");
	if (root) {
		let queued = false;
		const schedule = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				placeNotes(root);
			});
		};

		const observer = new ResizeObserver(schedule);
		observer.observe(root);
		root
			.querySelectorAll("[data-gazette-note], [data-note-anchor]")
			.forEach((element) => observer.observe(element));
		new MutationObserver(() => placeNotes(root)).observe(root, {
			attributeFilter: ["open"],
			subtree: true,
		});
		RAIL.addEventListener("change", schedule);
		document.fonts.ready.then(schedule);
		schedule();
	}
</script>
