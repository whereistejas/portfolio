---
import { getCollection } from "astro:content";

import Gazette from "../components/Gazette.astro";
import Page from "../layouts/page.astro";

const archiveEntries = (await getCollection("readwise-archive")).map(
	(entry) => entry.data
);
---

<Page title="Gazette">
	<Fragment slot="main">
		<Gazette
			name="Gazette"
			tagline="My reading list archive: what I read each week, and what I highlighted."
			items={archiveEntries}
		/>
	</Fragment>
</Page>
