---
import { getCollection } from "astro:content";

import Gazette from "../components/Gazette.astro";
import Page from "../layouts/page.astro";

const queueEntries = (await getCollection("readwise-queue")).map(
	(entry) => entry.data
);
---

<Page title="To Be Read" fonts={["economist-serif-roman.woff2"]}>
	<Fragment slot="main">
		<Gazette name="To Be Read" items={queueEntries} numbered={false} />
	</Fragment>
</Page>
