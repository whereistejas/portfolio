---
import FeedCard from "../components/FeedCard.astro";
import Textorlink from "../components/textorlink.astro";
import Page from "../layouts/page.astro";
import { markdownToPlainText } from "../lib/feed";

type Post = {
	frontmatter: {
		title: string;
		date: Date;
		description?: string;
	};
	url: string;
	rawContent: () => string;
};

const posts: Post[] = Object.values(
	import.meta.glob("./posts/*.md", { eager: true })
);

function firstParagraph(post: Post): string {
	const raw = post.rawContent?.();
	if (!raw) return "";
	const blocks = raw.split(/\n\n+/);
	return (
		blocks.find((b) => b.trim() && !b.trim().startsWith("#"))?.trim() ?? ""
	);
}

posts.sort(
	(a, b) =>
		new Date(b.frontmatter.date).getTime() -
		new Date(a.frontmatter.date).getTime()
);

const entries = await Promise.all(
	posts.map(async (post) => ({
		post,
		summary:
			post.frontmatter.description?.trim() ||
			(await markdownToPlainText(firstParagraph(post))),
		date: new Date(post.frontmatter.date).toLocaleDateString("en-GB", {
			day: "2-digit",
			month: "short",
			year: "numeric",
		}),
	}))
);
---

<Page title="Blog">
	<Fragment slot="header">
		<Textorlink content="BLOG" />
	</Fragment>
	<Fragment slot="main">
		<div class="feed">
			{
				entries.map(({ post, summary, date }) => (
					<FeedCard
						title={post.frontmatter.title}
						href={post.url}
						summary={summary}
						metaParts={[date]}
						linkWholeCard
					/>
				))
			}
		</div>
	</Fragment>
</Page>
